{
  "name": "@salts/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/security/*.test.ts src/providers/*.test.ts",
    "prebuild": "pnpm --filter @salts/database build",
    "pretypecheck": "pnpm --filter @salts/database build",
    "predev": "pnpm --filter @salts/database db:generate && pnpm --filter @salts/database build"
  },
  "dependencies": {
    "fastify": "^5.3.3",
    "@salts/database": "workspace:*",
    "argon2": "^0.41.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/helmet": "^13.0.1",
    "@aws-sdk/client-kms": "^3.850.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
