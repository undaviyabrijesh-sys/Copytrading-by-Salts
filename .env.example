# Local development only. Never commit real credentials.
NODE_ENV=development
APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
# Production: exact public HTTPS base for registered broker callbacks (no trailing slash).
# Example: https://api.example.com/api/v1/brokers/oauth
BROKER_OAUTH_CALLBACK_BASE=
# Set only to the official 5paisa login URL for your approved environment.
FIVE_PAISA_OAUTH_URL=
DATABASE_URL=postgresql://copydesk:copydesk_local_only@localhost:5432/copydesk
REDIS_URL=redis://localhost:6379
# Production only: AWS IAM task role + customer-managed KMS key in ap-south-1.
AWS_REGION=ap-south-1
BROKER_SECRETS_KMS_KEY_ID=
# Generate a unique 32-byte key (base64) and store it in a secret manager in production.
# Example generation: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
# Broker credentials must be entered through the secured application flow.
# Do not place broker API keys or secrets in this file.
