# Local development only. Never commit real credentials.
NODE_ENV=development
APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=postgresql://copydesk:copydesk_local_only@localhost:5432/copydesk
REDIS_URL=redis://localhost:6379
# Generate a unique 32-byte key (base64) and store it in a secret manager in production.
# Example generation: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
# Broker credentials must be entered through the secured application flow.
# Do not place broker API keys or secrets in this file.
